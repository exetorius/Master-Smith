# The chat's server-side settings. Copy to .env.local (ignored by git); everything here is optional for a local run.

# Where the Python API answers.
# MASTERSMITH_API_URL=http://127.0.0.1:8080
# The API's MASTERSMITH_API_KEY, if you set one in the repository's .env.
# MASTERSMITH_API_KEY=
# Ask for this password before showing the chat or answering its /api routes (any user name). Set it before the chat
# is reachable from another machine: whoever opens the chat spends your fal and OpenRouter credit.
# MASTERSMITH_WEB_PASSWORD=
