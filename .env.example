# Master Smith configuration. Copy to .env (ignored by git). Lines starting with # are defaults you can uncomment.

# ---------------------------------------------------------------- keys
# fal.ai draws the pictures (Nano Banana, ~$0.08 each) and runs the paid meshers (Tripo, Hi3D) when asked for.
FAL_KEY=
# Only for MASTERSMITH_LLM=openrouter (the old in-pipeline checks). The ms tools make no model calls of their own.
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------- spending
# 1 = every paid fal call is refused before it is made, except the picture models when PAID_PICTURES is on.
MASTERSMITH_NO_SPEND=1
# 1 = the fal picture models (Nano Banana) may run under no-spend. Meshes still come from TRELLIS on this PC.
MASTERSMITH_PAID_PICTURES=1
# Who answers the few model calls some helpers still make (the three-quarter picture check): claude-code, codex
# or openrouter.
MASTERSMITH_LLM=claude-code

# ---------------------------------------------------------------- where things live
# Headless Blender 5.2. Windows default below; elsewhere the `blender` binary.
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Jobs are written to <MASTERSMITH_DATA>/out/<Name>/. Default: the repository.
# MASTERSMITH_DATA=.

# ---------------------------------------------------------------- models on this PC (mastersmith/local.py)
# TRELLIS.2 (trellis-cli) meshes every part for free; FLUX.2 klein draws locally when a picture is asked for with
# --model local. Needs an NVIDIA GPU with ~10 GB free.
# MASTERSMITH_LOCAL_MODELS_DIR=E:\local-models
# MASTERSMITH_LOCAL_COMFY_URL=http://127.0.0.1:8188
# Geometry resolution 1024 (default) or 512 (about twice as fast, softer).
# MASTERSMITH_LOCAL_TRELLIS_RES=1024
# Weight set under models\trellis2: q8 (fits 12 GB), q4, or empty for f16.
# MASTERSMITH_LOCAL_TRELLIS_QUANT=q8
# Texture volume: empty = automatic (512); 1024 = sharper, about 3x slower.
# MASTERSMITH_LOCAL_TRELLIS_TEX_RES=

# ---------------------------------------------------------------- assembly
# 1 (default) = every part is meshed from its own pictures. 0 = primitive-shaped parts are modelled in Blender code
# with the hard-surface kit instead (mastersmith/blender/hskit.py).
# MASTERSMITH_ALL_VENDOR=1
# MASTERSMITH_ASSEMBLY_MAX_PARTS=24
# Picture models (fal ids): the defaults are Nano Banana 2 for parts and views, Nano Banana Pro for the hero picture.
# MASTERSMITH_EDIT_MODEL=fal-ai/nano-banana-2
# MASTERSMITH_CONCEPT_MODEL=fal-ai/nano-banana-2
# MASTERSMITH_IMAGE_RESOLUTION=1K
