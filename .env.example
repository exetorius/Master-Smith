# Master Smith configuration. Copy to .env (ignored by git). Lines starting with # are defaults you can uncomment.
# Every variable the code reads is listed here.

# ---------------------------------------------------------------- required: your own provider keys
# fal.ai makes the meshes, the masks and the rigs.
FAL_KEY=
# OpenRouter runs the director, the vision checks and the picture models.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- access
# A fixed API key for scripts, agents and the web app: any string you make up. Send it as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`; requests are then the user MASTERSMITH_API_USER.
# Leave it empty and every request is the local user: this is one person's tool.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# (the old example value ms_dev_change_me is refused at start-up: everyone knows it.)
MASTERSMITH_API_KEY=
# Browser origins that may call the API directly (the chat goes through its own server and needs nothing here).
# MASTERSMITH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The chat asks for this password (any user name) when set; docker-compose passes it to the web container. Set it
# before the chat is reachable from another machine: whoever opens it spends your fal and OpenRouter credit.
# MASTERSMITH_WEB_PASSWORD=
# MASTERSMITH_API_USER=agent

# ---------------------------------------------------------------- where things live
# Headless Blender 5.2. Windows default below; Linux/macOS: the `blender` binary. The Docker image sets its own.
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Builds (out/), uploads and the SQLite ledger. Default: the repository; docker-compose mounts a volume at /data.
# MASTERSMITH_DATA=./data
# 1 = the API only queues jobs; run `python -m mastersmith worker` (one or more) to build them.
# MASTERSMITH_NO_WORKER=0

# ---------------------------------------------------------------- language and vision models (OpenRouter ids)
# The director runs the chat and fills in the brief; cheap on purpose. This is the default in the chat's selector.
# MASTERSMITH_DIRECTOR_MODEL=google/gemini-3.8-flash
# The other director models the selector offers (comma-separated OpenRouter ids; each must support tool calls).
# The selector can also list every tool-and-vision-capable model OpenRouter serves, with prices.
# MASTERSMITH_DIRECTOR_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-6-luna,z-ai/glm-5.3-flash,openai/gpt-6-sol,meta/muse-spark-1.3-contributor,meta/muse-spark-1.3,anthropic/claude-sonnet-5,anthropic/claude-opus-5.5
# Picture checks, facing decisions, the review.
# MASTERSMITH_VISION_MODEL=google/gemini-3.8-flash
# Used for hard briefs when premium=true.
# MASTERSMITH_PREMIUM_MODEL=anthropic/claude-sonnet-5

# ---------------------------------------------------------------- picture models
# fal ids by default (the same account as the meshes): fal-ai/nano-banana-2, fal-ai/nano-banana, fal-ai/nano-banana-pro,
# fal-ai/flux-2, fal-ai/flux-2-pro. A fal id given reference pictures runs its /edit endpoint. OpenRouter image ids
# (google/gemini-3.1-flash-image, google/gemini-3-pro-image, openai/gpt-5-image, ...) work too.
# Text -> clean product shot.
# MASTERSMITH_CONCEPT_MODEL=fal-ai/nano-banana-2
# Concept picture for premium=true briefs.
# MASTERSMITH_CONCEPT_PREMIUM=fal-ai/nano-banana-pro
# Concept picture for hard-surface categories (weapon, vehicle, aircraft, helicopter): the seed reproduces every
# 2D error as geometry, so these get the stronger model.
# MASTERSMITH_CONCEPT_HARD=fal-ai/nano-banana-pro
# Photo -> clean view, extra views, assembly part pictures.
# MASTERSMITH_EDIT_MODEL=fal-ai/nano-banana-2
# Picture resolution asked of the image models: 1K or 2K.
# MASTERSMITH_IMAGE_RESOLUTION=1K
# off = never look up photographs on the web for a named real thing (search_query).
# MASTERSMITH_IMAGE_SEARCH=on

# ---------------------------------------------------------------- mesh vendor (fal endpoints)
# Empty = Tripo H3.1 (default). Alternatives: meshy7, meshy7mv (multi-image), hitem3d, hitem3d3 (2048-voxel),
# local (TRELLIS.2 on this PC, free).
# MASTERSMITH_SEED_MODEL=

# ---------------------------------------------------------------- free tier: models on this PC (mastersmith/local.py)
# Pick "TRELLIS.2 (this PC, free)" and "FLUX.2 klein 4B (free)" in the chat's selectors, or `cli run --free`, and the
# pictures (ComfyUI + FLUX.2 klein 4B, ~11 s) and the mesh (trellis.cpp + TRELLIS.2, 1.5-6.5 min) cost $0. The vision
# checks still run on OpenRouter. Needs an NVIDIA GPU with ~10 GB free; ComfyUI is started on first use.
# MASTERSMITH_LOCAL_MODELS_DIR=E:\local-models
# MASTERSMITH_LOCAL_COMFY_URL=http://127.0.0.1:8188
# Geometry resolution: 1024 (default) or 512 (about twice as fast, softer).
# MASTERSMITH_LOCAL_TRELLIS_RES=1024
# Weight set under models\trellis2: q8 (fits 12 GB), q4, or empty for f16.
# MASTERSMITH_LOCAL_TRELLIS_QUANT=q8
# Tripo quad topology (+$0.05, FBX out). Empty = by category (on for hard surfaces); 0/1 forces it.
# MASTERSMITH_SEED_QUAD=
